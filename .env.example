# ==============================================================================
# Indian Multi-Agent Trading System — Configuration & Environment Template
# COPY THIS FILE TO .env AND FILL IN YOUR CREDENTIALS
# DO NOT COMMIT .env TO SOURCE CONTROL OR SHARE IN CHAT
# ==============================================================================

# Core System Controls & Safety Guardrails
ENVIRONMENT=development
TIMEZONE=Asia/Kolkata
LOG_LEVEL=INFO

# Execution Guardrails (Live trading is OFF by default and fail-closed)
EXECUTION_MODE=PAPER
LIVE_TRADING_ENABLED=false
AGENT_BYPASS_ALLOWED=false

# Capital & Risk Controls (Strict defaults: under ₹25,000 capital, ₹250 daily loss cap)
STARTING_CAPITAL_INR=25000.00
DAILY_LOSS_LIMIT_INR=250.00
MAX_RISK_PER_TRADE_INR=250.00
MAX_OPEN_POSITIONS=2
MAX_DAILY_TRADES=6
INTRADAY_SQUARE_OFF_TIME=15:15

# Database Configuration (Local SQLite with WAL mode)
DATABASE_URL=sqlite+aiosqlite:///data/trading_system.db

# Upstox API Configuration (Official API v2/v3)
# Register your app at: https://developer.upstox.com/
UPSTOX_API_KEY=your_upstox_api_key_here
UPSTOX_API_SECRET=your_upstox_api_secret_here
UPSTOX_REDIRECT_URI=http://127.0.0.1:8000/api/v1/auth/upstox/callback
UPSTOX_ACCESS_TOKEN=

# Optional TOTP-based Headless Auth
UPSTOX_USER_ID=
UPSTOX_USER_PIN=
UPSTOX_TOTP_SECRET=

# Optional Telegram Notifications & Authentication
TELEGRAM_BOT_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_CHAT_IDS=
TELEGRAM_NOTIFICATION_CHAT_ID=

# Web Server & Dashboard
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
FRONTEND_PORT=5173
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","http://localhost:8000","http://127.0.0.1:8000"]

